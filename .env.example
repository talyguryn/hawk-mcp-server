# Optional Hawk API endpoint override
HAWK_API_URL=https://api.hawk.so/graphql
# Maximum wait for one Hawk API request. Keep below the MCP tool timeout.
# HAWK_REQUEST_TIMEOUT_MS=15000

# Optional token storage override. Keep this outside the repository.
# HAWK_MCP_SESSION_STORE_PATH=/absolute/path/to/session.json

# Local stdio is the default. Use httpStream with an access token for a server:
# HAWK_MCP_TRANSPORT=httpStream
# HAWK_MCP_HOST=0.0.0.0
# HAWK_MCP_PORT=3000
# HAWK_MCP_ENDPOINT=/mcp
# HAWK_MCP_HTTP_AUTH_TOKEN=replace-with-a-random-token-at-least-24-characters-long
